:root {
}

.HorizontalBar {
}

.unity-progress-bar {
    scale: 1 3;
    font-size: 26px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    text-shadow: 1.8px 0 15px rgb(0, 0, 0);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Library/unity%20default%20resources?fileID=10102&guid=0000000000000000e000000000000000&type=0#LegacyRuntime");
    letter-spacing: 6px;
    word-spacing: 5px;
}

.VertBar {
    transform-origin: center;
    scale: 1 3;
    align-items: flex-start;
    align-self: flex-start;
    top: 407px;
    bottom: auto;
}
