:root {
}

.panel {
    flex-grow: 1;
    background-color: rgb(16, 97, 105);
}

.ButBox {
    background-color: rgb(12, 68, 74);
    justify-content: flex-end;
    align-items: center;
    align-content: center;
    flex-grow: 1;
    opacity: 1;
    scale: 0.5 0.5;
    top: -100px;
}

.unity-button {
    aspect-ratio: auto;
    width: 622px;
    height: 529px;
    font-size: 134px;
    -unity-text-align: middle-center;
    white-space: pre-wrap;
}

.unity-button:hover {
    background-color: rgb(255, 204, 0);
    scale: 1.25 1.25;
    transition-property: scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
}

.unity-button:focus {
    scale: 0.75 0.75;
    transition-property: scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
    background-color: rgb(180, 144, 0);
}
